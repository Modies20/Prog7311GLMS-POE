@model IEnumerable<GLMS.Data.Entities.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-truck"></i> Service Requests</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Raise Service Request
    </a>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5 class="card-title">Total Requests</h5>
                <h2>@ViewBag.TotalRequests</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <h5 class="card-title">Pending</h5>
                <h2>@ViewBag.PendingRequests</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5 class="card-title">Completed</h5>
                <h2>@ViewBag.CompletedRequests</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-dark text-white">
            <div class="card-body">
                <h5 class="card-title">Total Value (ZAR)</h5>
                <h2>R @ViewBag.TotalValueZAR?.ToString("N0")</h2>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Request #</th>
                <th>Contract</th>
                <th>Client</th>
                <th>Description</th>
                <th>Amount (USD)</th>
                <th>Amount (ZAR)</th>
                <th>Status</th>
                <th>Request Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RequestNumber</td>
                    <td>@item.Contract?.ContractNumber</td>
                    <td>@item.Contract?.Client?.Name</td>
                    <td>@(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</td>
                    <td>$@item.AmountUSD.ToString("N2")</td>
                    <td>R @item.AmountZAR.ToString("N2")</td>
                    <td>
                        @{
                            var statusClass = item.Status switch
                            {
                                GLMS.Data.Entities.RequestStatus.Pending => "warning",
                                GLMS.Data.Entities.RequestStatus.Approved => "info",
                                GLMS.Data.Entities.RequestStatus.InProgress => "primary",
                                GLMS.Data.Entities.RequestStatus.Completed => "success",
                                GLMS.Data.Entities.RequestStatus.Cancelled => "danger",
                                _ => "secondary"
                            };
                        }
                        <span class="badge bg-@statusClass">@item.Status</span>
                    </td>
                    <td>@item.RequestDate.ToShortDateString()</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.ServiceRequestId" class="btn btn-sm btn-info" title="Details">
                            <i class="fas fa-info-circle"></i>
                        </a>
                        @if (item.Status != GLMS.Data.Entities.RequestStatus.Completed && item.Status != GLMS.Data.Entities.RequestStatus.Cancelled)
                        {
                            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#statusModal@(item.ServiceRequestId)" title="Update Status">
                                <i class="fas fa-check-circle"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Status Update Modals (move outside of tbody to fix HTML0204) -->
@foreach (var item in Model)
{
    if (item.Status != GLMS.Data.Entities.RequestStatus.Completed && item.Status != GLMS.Data.Entities.RequestStatus.Cancelled)
    {
        <div class="modal fade" id="statusModal@(item.ServiceRequestId)" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Update Status</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form asp-action="UpdateStatus" asp-route-id="@item.ServiceRequestId" method="post">
                        <div class="modal-body">
                            <label class="form-label">Select new status for @item.RequestNumber</label>
                            <select name="status" class="form-select">
                                @foreach (var status in Enum.GetValues(typeof(GLMS.Data.Entities.RequestStatus)).Cast<GLMS.Data.Entities.RequestStatus>())
                                {
                                    <option value="@(Convert.ToInt32(status))" selected="@(item.Status == status ? "selected" : null)">
                                        @status
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Update Status</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="fas fa-info-circle"></i> No service requests found. Click "Raise Service Request" to get started.
    </div>
}