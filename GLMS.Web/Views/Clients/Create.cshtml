@model GLMS.Data.Entities.Client

@{
    ViewData["Title"] = "Create Client";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4><i class="fas fa-user-plus"></i> Create New Client</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter company name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="contact@company.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" placeholder="+27 XX XXX XXXX" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="2" placeholder="Street address, city, postal code"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Region" class="form-label"></label>
                        <select asp-for="Region" class="form-select">
                            <option value="">-- Select Region --</option>
                            <option value="Africa">Africa</option>
                            <option value="Asia">Asia</option>
                            <option value="Europe">Europe</option>
                            <option value="North America">North America</option>
                            <option value="South America">South America</option>
                            <option value="Australia">Australia</option>
                        </select>
                        <span asp-validation-for="Region" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TaxId" class="form-label">Tax ID / VAT Number</label>
                        <input asp-for="TaxId" class="form-control" placeholder="Optional" />
                        <span asp-validation-for="TaxId" class="text-danger"></span>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Create Client
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-info-circle"></i> Information</h5>
            </div>
            <div class="card-body">
                <p><strong>Client Information:</strong></p>
                <ul>
                    <li>Client represents a company or organization</li>
                    <li>Each client can have multiple contracts</li>
                    <li>Email must be unique in the system</li>
                    <li>Region helps with logistics planning</li>
                </ul>
                <hr />
                <p><strong>Required Fields:</strong></p>
                <ul>
                    <li>Company Name</li>
                    <li>Email Address</li>
                    <li>Phone Number</li>
                    <li>Physical Address</li>
                    <li>Region</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}